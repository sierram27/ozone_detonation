FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverTypeProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// New in detonationFoam v1.2. Selects the equations solved.
// The Stanford case ran detonationNSFoam_Sutherland (v1.0). By the user's decision
// (2026-11-16) this baseline is run INVISCID: reactive Euler equations, with no
// viscosity, heat conduction or species diffusion. See 03_case/CHANGES.md (#9).
solverType  Euler;           // options: Euler; NS_Sutherland; NS_mixtureAverage

// The run stops when the "leading shock" (furthest cell with p > 101425 Pa, hard-coded)
// reaches this x [m]. The domain ends at x = 0.5 m, so 1.0 (the solver's default) never
// triggers. The run ends at endTime, as in the original case.
SW_position_limit   1.0;

